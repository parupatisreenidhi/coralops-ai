# ============================================================
# CoralOps AI — .gitignore
# ============================================================

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
frontend/node-modules/

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env
*.env
*.env.*
!*.env.example

# ── Environment files ────────────────────────────────────────
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
frontend/.env.local
backend/.env

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDE / Editors ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.cursor/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Testing ──────────────────────────────────────────────────
coverage/
.coverage
htmlcov/
.pytest_cache/
.hypothesis/
*.lcov

# ── Package managers ─────────────────────────────────────────
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
package-lock.json
# keep: yarn.lock or pnpm-lock.yaml if you use them

# ── ChromaDB / Vector store ──────────────────────────────────
chroma_db/
chromadb/
*.chroma
vector_store/

# ── Misc ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
.cache/
tmp/
temp/
